# Postgres (docker compose)
DB_USER=shiftly
DB_PASSWORD=change-me
DB_NAME=shiftly
DB_PORT=5432

# App
APP_PORT=3000
# Built from the DB_* values above: Bun and Next expand ${...} in .env, and
# drizzle.config.ts resolves them for node-run scripts — change DB_*, not this
# line. Percent-encode special characters in DB_PASSWORD (@ : / ? #) first.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# Auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:${APP_PORT}

# Admin bootstrap seed (bun run db:seed-admin)
# Order matters: docker compose up -d → bun run db:migrate → seed. The password
# needs ≥ 15 characters; re-running is a no-op once the admin exists.
ADMIN_EMAIL=admin@shiftly.test
ADMIN_PASSWORD=generate-a-strong-password
